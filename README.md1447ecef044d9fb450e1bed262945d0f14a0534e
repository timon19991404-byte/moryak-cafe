<!DOCTYPE html>
<html lang="ky">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>МОРЯК — Админ панель</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f2f6fa;
      color: #173047;
    }
    header {
      background: #123b56;
      color: white;
      padding: 24px 18px;
      text-align: center;
    }
    header h1 { margin: 0 0 8px; }
    main {
      max-width: 700px;
      margin: 24px auto;
      padding: 0 16px;
    }
    .card {
      background: white;
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 3px 14px #123b5612;
    }
    label { display: block; margin: 12px 0 6px; }
    input {
      width: 100%;
      padding: 12px;
      border: 1px solid #cbd5df;
      border-radius: 8px;
      font-size: 16px;
    }
    button {
      background: #087e8b;
      color: white;
      border: 0;
      padding: 12px 16px;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;
      margin-top: 14px;
    }
    .item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid #e5ebef;
      padding: 12px 0;
    }
    .delete { background: #b83232; margin: 0; }
    .muted { color: #617486; font-size: 14px; }
  </style>
</head>
<body>
  <header>
    <h1>⚓ МОРЯК</h1>
    <div>Кафенин менюсун башкаруу</div>
  </header>

  <main>
    <section class="card">
      <h2>➕ Жаңы тамак кошуу</h2>
      <label for="food">Тамактын аты</label>
      <input id="food" placeholder="Мисалы: Балык шорпо">

      <label for="price">Баасы (сом)</label>
      <input id="price" type="number" min="0" placeholder="250">

      <button onclick="addFood()">Менюга кошуу</button>
      <p class="muted">Бул азырынча сыноо версиясы: маалымат ушул браузерде гана сакталат.</p>
    </section>

    <section class="card">
      <h2>📋 Меню</h2>
      <div id="menu">Меню азырынча бош.</div>
    </section>
  </main>

  <script>
    let foods = JSON.parse(localStorage.getItem("moryakFoods") || "[]");

    function renderMenu() {
      const menu = document.getElementById("menu");
      menu.innerHTML = "";

      if (!foods.length) {
        menu.textContent = "Меню азырынча бош.";
        return;
      }

      foods.forEach((food, index) => {
        const row = document.createElement("div");
        row.className = "item";

        const info = document.createElement("span");
        info.textContent = food.name + " — " + food.price + " сом";

        const del = document.createElement("button");
        del.className = "delete";
        del.textContent = "Өчүрүү";
        del.onclick = () => {
          foods.splice(index, 1);
          saveFoods();
        };

        row.append(info, del);
        menu.appendChild(row);
      });
    }

    function saveFoods() {
      localStorage.setItem("moryakFoods", JSON.stringify(foods));
      renderMenu();
    }

    function addFood() {
      const name = document.getElementById("food").value.trim();
      const price = Number(document.getElementById("price").value);

      if (!name || !Number.isFinite(price) || price <= 0) {
        alert("Тамактын атын жана туура баасын киргиз, досум!");
        return;
      }

      foods.push({ name, price });
      saveFoods();
      document.getElementById("food").value = "";
      document.getElementById("price").value = "";
    }

    renderMenu();
  </script>
</body>
</html>
